# Database (Supabase PostgreSQL Pooler or Direct Connection)
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase Project (never commit real keys)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# App & Security
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-chars-random-secret-key"
NODE_ENV="development"

# Logging
LOG_LEVEL="info"
